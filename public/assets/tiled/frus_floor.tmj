        { "id": 3, "name": "parchment_west", "type": "solid", "x": 0, "y": 0, "width": 90, "height": 1024 },
        { "id": 4, "name": "parchment_east", "type": "solid", "x": 1446, "y": 0, "width": 90, "height": 1024 },
        { "id": 5, "name": "research_desks", "type": "solid", "x": 104, "y": 200, "width": 170, "height": 455 },
        { "id": 6, "name": "compilation_shelves", "type": "solid", "x": 370, "y": 205, "width": 215, "height": 455 },
        { "id": 7, "name": "declass_table", "type": "solid", "x": 675, "y": 465, "width": 210, "height": 180 },
        { "id": 8, "name": "annotation_desks", "type": "solid", "x": 970, "y": 215, "width": 200, "height": 430 },
        { "id": 9, "name": "publication_press", "type": "solid", "x": 1245, "y": 200, "width": 185, "height": 455 }
      ]
